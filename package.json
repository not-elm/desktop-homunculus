{
  "name": "desktop-homunculus",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "build": "turbo run build",
    "build:builtin-ui": "pnpm --filter \"{./engine/ui/*}...\" --fail-if-no-match run build",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "lint:styling": "bash scripts/check-styling.sh",
    "lint:styling:full": "bash scripts/check-styling.sh --full",
    "lint:styling:test": "bash scripts/test-check-styling.sh",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11"
  },
  "pnpm": {
    "overrides": {
      "@anthropic-ai/sdk@>=0.79.0 <0.91.1": "^0.91.1",
      "@hono/node-server@<2.1.3": "^2.1.3",
      "@modelcontextprotocol/sdk@<1.32.0": "^1.32.0",
      "basic-ftp@<6.2.4": "^6.2.4",
      "glob@>=9.0.0 <14.0.2": "^14.0.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "lodash@<4.18.1": "^4.18.1",
      "markdown-it@<14.3.3": "^14.3.3",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
      "openclaw@<2026.4.20": "2026.4.26",
      "serialize-javascript@<7.1.3": "^7.1.3",
      "tar@<7.5.21": "^7.5.21",
      "tinypool@<2.1.2": "^2.1.2",
      "undici@>=8.0.0 <8.12.2": "^8.12.2",
      "uuid@<11.1.1": "^11.1.1",
      "yaml@>=1.0.0 <1.10.3": "^1.10.3"
    }
  }
}
